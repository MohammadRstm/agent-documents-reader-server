{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Limits": {
    "UploadRequestsPerMinute": 10,
    "ChatRequestsPerMinute": 20,
    "MaxModelRoundTripsPerQuestion": 8,
    "QuestionTimeoutSeconds": 120
  },
  "Sessions": {
    "IdleTimeoutMinutes": 60,
    "CleanupIntervalSeconds": 60
  },
  "Anthropic": {
    "Model": "claude-sonnet-5-5",
    "Effort": "medium"
  }
}
