{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Limits": {
    "SessionCreationRequestsPerMinute": 10,
    "UploadRequestsPerMinute": 60,
    "ChatRequestsPerMinute": 20,
    "MaxFileSizeBytes": 26214400,
    "MaxFilesPerUpload": 10,
    "MaxUploadRequestBytes": 104857600,
    "MaxDocumentsPerSession": 20,
    "MaxFailedDocumentsPerSession": 50,
    "MaxPdfPages": 500,
    "MaxParallelExtractions": 4,
    "ExtractionTimeoutSeconds": 30,
    "MaxUncompressedWorkbookBytes": 104857600,
    "MaxWorkbookPackageEntries": 10000,
    "MaxWorkbookCompressionRatio": 100,
    "WorkbookCompressionRatioCheckBytes": 1048576,
    "MaxSheetsPerWorkbook": 100,
    "MaxCellsPerWorkbook": 1000000,
    "MaxExcelRows": 100000,
    "MaxExcelColumns": 512,
    "MaxCellTextLength": 2000,
    "MaxMergedRangeCells": 10000,
    "MaxModelRoundTripsPerQuestion": 8,
    "QuestionTimeoutSeconds": 120
  },
  "Sessions": {
    "IdleTimeoutMinutes": 60,
    "CleanupIntervalSeconds": 60
  },
  "Anthropic": {
    "Model": "claude-sonnet-5-5",
    "Effort": "medium",
    "MaxOutputTokens": 16000
  }
}
